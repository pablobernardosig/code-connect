{
  "name": "code-connect",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev:react": "pnpm --filter ./apps/react-app dev",
    "build:react": "pnpm --filter ./apps/react-app build",
    "preview:react": "pnpm --filter ./apps/react-app preview",

    "dev:nest": "pnpm --filter ./apps/nest-app start:dev",
    "start:nest": "pnpm --filter ./apps/nest-app start",
    "build:nest": "pnpm --filter ./apps/nest-app build"
  }
}

